# HealthCare_Project local development environment
# Copy to .env for local use. Do not commit real .env files.

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/healthcare
DATABASE_USERNAME=healthcare
DATABASE_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=healthcare
MINIO_SECRET_KEY=change-me
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-me-use-a-256-bit-secret-key-for-production-environment-please
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_APP_NAME=HealthCare Project
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# AI service
AI_SERVICE_PORT=8000
AI_PROVIDER=rule_based_triage
EMBEDDING_PROVIDER=local

# Optional DeepSeek LLM provider; rule-based triage remains the safe default.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_INGEST_ENABLED=false
RAG_INGEST_TOKEN=

# Local infrastructure
POSTGRES_DB=healthcare
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=healthcare
MINIO_ROOT_PASSWORD=change-me
