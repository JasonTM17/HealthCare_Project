# HealthCare_Project local development environment
# Copy to .env for local use. Do not commit real .env files.

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5434/healthcare
DATABASE_USERNAME=healthcare
DATABASE_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=healthcare
MINIO_SECRET_KEY=change-me
AI_SERVICE_URL=http://localhost:8000
# Bare local process escape hatch only. Compose also has a documented local-only
# fallback; replace this placeholder with a private value for every shared run.
AI_SERVICE_RUNTIME=local
AI_SERVICE_ALLOW_UNAUTHENTICATED_LOCAL=true
AI_SERVICE_TOKEN=local-development-token-not-for-production
JWT_SECRET=change-me-use-a-256-bit-secret-key-for-production-environment-please
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Same-origin browser traffic uses the BFF, so direct Spring CORS stays empty.
CORS_ALLOWED_ORIGINS=
BFF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BFF_PUBLIC_ORIGIN=http://localhost:3000
BACKEND_BFF_REQUIRED=true
APP_SECURITY_RATE_LIMIT_ENABLED=true
APP_SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
APP_SECURITY_RATE_LIMIT_AUTH_LIMIT=20
APP_SECURITY_RATE_LIMIT_APPOINTMENT_LIMIT=60
APP_SECURITY_RATE_LIMIT_AI_LIMIT=30
APP_SECURITY_RATE_LIMIT_PAYMENT_LIMIT=20
APP_SECURITY_RATE_LIMIT_WEBHOOK_LIMIT=120
# Fixed OTP values are accepted only by the Spring `test` profile. Compose sends
# a random booking OTP through the configured SMTP service.
APP_BOOKING_ALLOW_TEST_OTP=false
# Chỉ là dữ liệu demo. Thay bằng tài khoản đối soát riêng trước khi dùng chung.
APP_PAYMENT_BANK_TRANSFER_ENABLED=true
PAYMENT_BANK_NAME=Vietcombank LOCAL DEMO
PAYMENT_BANK_BIN=970436
PAYMENT_BANK_ACCOUNT=0123456789
PAYMENT_BANK_ACCOUNT_HOLDER=HEALTHCARE DEMO
PAYMENT_DEFAULT_AMOUNT=200000
# Ít nhất 32 ký tự; để trống thì webhook tự động đối soát bị khóa an toàn.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Transactional status messages are queued only after the payment transaction commits.
PAYMENT_STATUS_EMAIL_ENABLED=true
APP_MAIL_ENABLED=true
APP_MAIL_FROM=no-reply@healthcare.local
APP_MAIL_OUTBOX_ENABLED=false
# Required process/secret-manager injection for local Compose, which always
# enables the outbox. Keep one key across pending mail retries; never commit it.
APP_MAIL_OUTBOX_ENCRYPTION_KEY=
APP_MAIL_OUTBOX_POLL_MS=5000
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_STARTTLS_ENABLE=false
SPRING_MAIL_STARTTLS_REQUIRED=false
SPRING_MAIL_CONNECTION_TIMEOUT=5000
SPRING_MAIL_TIMEOUT=5000
SPRING_MAIL_WRITE_TIMEOUT=5000
APP_AUTH_OTP_ENABLED=true
APP_AUTH_OTP_TTL_SECONDS=600
APP_AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
APP_AUTH_OTP_WINDOW_SECONDS=900
APP_AUTH_OTP_IP_LIMIT=20
APP_AUTH_OTP_EMAIL_LIMIT=5
AI_CHAT_RETENTION_DAYS=90
AI_CHAT_CLEANUP_ENABLED=true
AI_CHAT_CLEANUP_CRON=0 20 3 * * *
AI_CHAT_CLEANUP_BATCH_SIZE=200
AI_CHAT_CLEANUP_MAX_BATCHES=20
AI_CHAT_PROCESSING_LEASE_SECONDS=120
# Clinical patient-chat modes are disabled by default outside the local
# synthetic-approval Compose profile. Production rollback should set both false.
AI_CHAT_SYMPTOM_TRIAGE_ENABLED=false
AI_CHAT_HEALTH_EDUCATION_ENABLED=false

# Frontend
NEXT_PUBLIC_APP_NAME=HealthCare Project
# Browser traffic always uses the same-origin /api/v1 BFF. These values are
# server-only and must never use the NEXT_PUBLIC_ prefix.
BACKEND_INTERNAL_URL=http://127.0.0.1:8080
# Generate at least 32 random bytes for each environment and configure the
# exact same secret on Spring. Compose fails closed when this value is missing.
BACKEND_BFF_SERVICE_TOKEN=
# Optional: only needed for the interactive iframe on branch detail pages.
# Without it, the site still opens each backend-owned address in Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# AI service. Provider credentials are server-only; never use NEXT_PUBLIC_* here.
# Local/test defaults are deterministic and offline. Set AI_PROVIDER=deepseek
# only in an explicitly approved dev/staging environment after the privacy,
# PII-negative-test, key-rotation and retention gates have passed.
AI_SERVICE_PORT=8000
AI_PROVIDER=local
EMBEDDING_PROVIDER=local
AI_API_KEY=
AI_CHAT_MODEL=local-deterministic
AI_EMBEDDING_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=10
AI_MAX_INPUT_CHARS=10000
AI_MAX_RETRIEVED_CHUNKS=5
AI_PATIENT_CHAT_REMOTE_ENABLED=false
# Spring's independent provenance gate; keep off unless DeepSeek/privacy gates pass.
AI_CHAT_REMOTE_PROVIDER_ENABLED=false
# Remote patient chat is synthetic-beta only and is fail-closed by default.
AI_SERVICE_RUNTIME=local
REMOTE_AI_SYNTHETIC_ONLY=true
REMOTE_AI_KILL_SWITCH=false
REMOTE_AI_PROVIDER_ALLOWLIST=deepseek
REMOTE_AI_HTTPS_HOST_ALLOWLIST=api.deepseek.com
AI_CHAT_CIRCUIT_FAILURE_THRESHOLD=3
AI_CHAT_CIRCUIT_RESET_SECONDS=30
RAG_MAX_DOCUMENT_CHARS=20000
RAG_MAX_DOCUMENTS=10000
RAG_STORAGE_BACKEND=memory
SUPABASE_DB_URL=
SUPABASE_DB_SCHEMA=healthcare

# Consultation attachments remain disabled until private object storage and an
# AV/MIME scanner are provisioned. Never commit real credentials here.
STORAGE_CONSULTATION_ENABLED=false
STORAGE_CONSULTATION_KEY_SIGNING_SECRET=
STORAGE_ENDPOINT=
# Optional browser signing origin. Local Compose uses a separate loopback host;
# hosted storage uses HTTPS. Set the region explicitly when this is provided.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=healthcare-beta-private
STORAGE_REQUIRE_PRIVATE_ENDPOINT=true
STORAGE_UPLOAD_ENABLED=false
STORAGE_AV_REQUIRED=true
STORAGE_AV_SERVICE_URL=
STORAGE_AV_SERVICE_TOKEN=
# Patient chatbot projection (separate from the legacy catalog index).
SUPABASE_RAG_TABLE=ai_chat_documents
SUPABASE_RAG_RPC=match_chat_documents
SUPABASE_DB_CONNECT_TIMEOUT_SECONDS=5
SUPABASE_RAG_FALLBACK_TO_MEMORY=false
RAG_EMBEDDING_DIMENSION=384

# Optional legacy DeepSeek aliases. They are considered only when
# AI_PROVIDER=deepseek and the corresponding AI_* value above is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_EMBEDDING_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_INGEST_ENABLED=true
RAG_INGEST_TOKEN=local-rag-ingest-token-not-for-production
# The local Compose helper generates this separate token and enables both sides
# before it performs the protected catalog synchronization.
AI_RAG_INGEST_ENABLED=true
AI_RAG_INGEST_TOKEN=local-rag-ingest-token-not-for-production

# Local infrastructure
POSTGRES_DB=healthcare
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
AI_SERVICE_HOST_PORT=8000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=healthcare
MINIO_ROOT_PASSWORD=change-me
